name: Print Software Versions

on:
  push:
    branches: [ laboratory-work-4 ]

jobs:
  PrintLanguageVersions:
    runs-on: ubuntu-latest
    steps:
      - name: Print .NET Version (Business Logic / Data Processing)
        run: dotnet --version
      - name: Print C# Compiler / SDK Info
        run: dotnet --info

  PrintDBMSVersions:
    runs-on: ubuntu-latest
    needs: [PrintLanguageVersions]
    steps:
      - name: Print Python Version (Data Processing & ML / AI Agent)
        run: python --version
      - name: Print Node.js Version (Frontend / Web components)
        run: node --version
